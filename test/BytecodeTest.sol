pragma solidity ^0.8.0;

import {Test} from "../lib/forge-std/src/Test.sol";

// Init codes of the deployed contracts.
bytes constant MIDNIGHT_INIT_CODE =
    hex"";
bytes constant SETTER_RATIFIER_INIT_CODE =
    hex"";
bytes constant ECRECOVER_RATIFIER_INIT_CODE =
    hex"";
bytes constant RATE_RATIFIER_V1_INIT_CODE =
    hex"";
bytes constant PRICE_RATIFIER_V1_INIT_CODE =
    hex"";
bytes constant ECRECOVER_AUTHORIZER_INIT_CODE =
    hex"";
bytes constant LOG_INIT_CODE =
    hex"608080604052346013576078908160188239f35b5f80fdfe608080604052620f42403611605c578060207f0b76c48be4e2908f4c9d4eabaf7538e91577fd9ae26db46693fa8d861c6a42fb9252366020820152365f60408301375f60403683010152604081601f19601f3601168101030190a1005b63326d141f60e01b5f5260045ffdfea164736f6c6343000822000a";
