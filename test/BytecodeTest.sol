    hex"";
bytes constant BLUE_FALLBACK_ROLLING_INIT_CODE =
    hex"";
bytes constant WHITELIST_ENTER_GATE_FACTORY_INIT_CODE =
    hex"";

contract BytecodeTest is Test {
    function testMidnightBytecode() public view {
        assertEq(vm.getCode("Midnight"), MIDNIGHT_INIT_CODE);
    }

    function testSetterRatifierBytecode() public view {
        assertEq(vm.getCode("SetterRatifier"), SETTER_RATIFIER_INIT_CODE);
    }

    function testEcrecoverRatifierBytecode() public view {
        assertEq(vm.getCode("EcrecoverRatifier"), ECRECOVER_RATIFIER_INIT_CODE);
    }

    function testRateRatifierV1Bytecode() public view {
        assertEq(vm.getCode("RateRatifierV1"), RATE_RATIFIER_V1_INIT_CODE);
    }

    function testPriceRatifierV1Bytecode() public view {
        assertEq(vm.getCode("PriceRatifierV1"), PRICE_RATIFIER_V1_INIT_CODE);
    }

    function testEcrecoverAuthorizerBytecode() public view {
        assertEq(vm.getCode("EcrecoverAuthorizer"), ECRECOVER_AUTHORIZER_INIT_CODE);
    }

    function testLogBytecode() public view {
        assertEq(vm.getCode("Log"), LOG_INIT_CODE);
    }

    function testBlueBuyCallbackFactoryBytecode() public view {
        assertEq(vm.getCode("BlueBuyCallbackFactory"), BLUE_BUY_CALLBACK_FACTORY_INIT_CODE);
    }

    function testBlueFallbackRollingBytecode() public view {
        assertEq(vm.getCode("BlueFallbackRolling"), BLUE_FALLBACK_ROLLING_INIT_CODE);
    }

    function testWhitelistEnterGateFactoryBytecode() public view {
        assertEq(vm.getCode("WhitelistEnterGateFactory"), WHITELIST_ENTER_GATE_FACTORY_INIT_CODE);
    }
}
