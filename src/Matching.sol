import {Offer} from "./interfaces/IMorphoV2.sol";
import {IMatching} from "./interfaces/IMatching.sol";
import "forge-std/console.sol";

import {WAD} from "./libraries/ConstantsLib.sol";
int256 constant MIN_TICK = -1679;
int256 constant MAX_TICK = 1679;

contract Matching is IMatching {
    error OutOfTicks();

    /// Byte offset of the price table in the contract bytecode.
    uint256 public constant TABLE_OFFSET = 2909;

    function getPrice(Offer memory offer) external view returns (uint256 price) {
        uint256 elapsed = block.timestamp - offer.start;
        uint256 duration = offer.expiry - offer.start;
        int256 tick;
        if (duration == 0) {
            tick = offer.startTick;
        } else {
            tick = offer.startTick + (offer.expiryTick - offer.startTick) * int256(elapsed) / int256(duration);
        }
        price = tickToPrice(tick);
    }

    function tickToPrice(int256 tick) public view returns (uint256) {
        unchecked {
            if (tick <= 0) {
                uint256 t = uint256(-tick);
                require(t <= uint256(MAX_TICK), OutOfTicks());
                return _getPrice(t);
            } else {
                uint256 t = uint256(tick);
                require(t <= uint256(MAX_TICK), OutOfTicks());
                return WAD - _getPrice(t);
            }
        }
    }

    function priceToTick(uint256 price, int256 lowTick, int256 highTick) public view returns (int256) {
        // Price decreases as tick increases, so search for first tick where price <= target
        unchecked {
            while (lowTick < highTick) {
                int256 mid = lowTick + (highTick - lowTick) / 2;
                if (tickToPrice(mid) > price) {
                    lowTick = mid + 1;
                } else {
                    highTick = mid;
                }
            }
        }
        return lowTick;
    }

    function _getPrice(uint256 n) private pure returns (uint256 val) {
        assembly {
            let base := TABLE_OFFSET
            let blockNum := div(n, 6)
            let posInBlock := mod(n, 6)
            // Each value takes 10 bytes: PUSH9 opcode + 1 marker byte + 8 data bytes.
            // Each block of values contains 6 values and 1 log4 opcode so takes 61 bytes.
            let offset := add(base, add(mul(blockNum, 61), add(mul(posInBlock, 10), 2)))
            mstore(0, 0)
            codecopy(24, offset, 8)
            val := mload(0)
        }
    }

